# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed client origins (leave empty to allow all in dev)
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/taxichat

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Format Nd (days), e.g. 30d
JWT_EXPIRES_IN=30d

# Cloudinary (avatars and chat photos)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# TURN server for voice calls (deployed in RF, see section 1.7.1 of the concept)
# TURN_URL=turn:turn.example.ru:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
# TURN_SECRET=
